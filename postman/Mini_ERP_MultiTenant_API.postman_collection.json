    {
      "name": "3. Transactions Module",
      "description": "Endpoint kasir dan transaksi. Mengimplementasikan Price Snapshotting, Database Transaction Atomicity, dan Transaksi Bersifat Immutable.",
      "item": [
        {
          "name": "3.1 Get All Transactions (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Transactions array with pagination meta\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.data).to.be.an('array');",
                  "    pm.expect(res).to.have.property('meta');",
                  "    ",
                  "    if (res.data.length > 0) {",
                  "        pm.environment.set(\"transaction_id\", res.data[0].id);",
                  "    }",
                  "});"
                ],
