                  "    pm.expect(res.errors['items.0.product_id'][0]).to.include('bukan milik tenant Anda');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
