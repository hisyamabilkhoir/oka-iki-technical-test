                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token received and saved to environment\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.token).to.be.a('string');",
                  "    pm.expect(res.user.role).to.eql('owner');",
                  "    pm.expect(res.user.tenant.name).to.eql('PT Nusantara Niaga Mandiri');",
                  "    ",
                  "    pm.environment.set(\"token\", res.token);",
                  "    pm.environment.set(\"user_role\", res.user.role);",
